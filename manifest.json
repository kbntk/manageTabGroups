{
  "manifest_version": 3,
  "name": "Manage Tab Groups",
  "version": "1.0.1",
  "description": "View and manage tab groups: add/remove tabs, change group color.",
  "permissions": ["tabs", "tabGroups", "search", "storage"],
  "action": {
    "default_title": "Manage tab groups"
  },
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["manager.html"],
      "matches": ["<all_urls>"]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "manage-tab-groups@jakubzakrzewski.eu",
      "strict_min_version": "139.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
